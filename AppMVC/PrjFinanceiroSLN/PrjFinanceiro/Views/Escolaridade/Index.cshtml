@model IEnumerable<PrjFinanceiro.Models.Escolaridade>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Escolaridade</h2>
    <p><a href="/Escolaridade/Criar" class="btn btn-success">Cadastrar Nova Escolaridade</a></p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Escolaridade/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-sm btn-danger" 
                                onclick="exibirModalExcluir(@item.Codigo, '@item.Descricao')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalConfirmacao" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Deseja realmente excluir a escolaridade <strong id="nomeItem"></strong>?</p>
                <input type="hidden" id="idItemExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="executarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

<script>
    function exibirModalExcluir(id, nome) {
        document.getElementById('idItemExcluir').value = id;
        document.getElementById('nomeItem').innerText = nome;
        var myModal = new bootstrap.Modal(document.getElementById('modalConfirmacao'));
        myModal.show();
    }

    function executarExclusao() {
        var id = document.getElementById('idItemExcluir').value;

        fetch('/Escolaridade/ExcluirConfirmadoModal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'codigo=' + id
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload(); // Recarrega a lista para mostrar a alteração
            } else {
                alert("Erro ao excluir.");
            }
        });
    }
</script>