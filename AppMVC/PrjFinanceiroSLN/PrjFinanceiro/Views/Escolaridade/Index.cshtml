@model IEnumerable<PrjFinanceiro.Models.Escolaridade>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Escolaridade</h2>

    <p>
        <a href="/Escolaridade/Criar" class="btn btn-success">Cadastrar Nova Escolaridade</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Escolaridade/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-sm btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.Descricao')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Deseja excluir a escolaridade: <strong id="nomeModal"></strong>?</p>
                <input type="hidden" id="idExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

<script>
    function abrirModalExcluir(id, nome) {
        $('#idExcluir').val(id);
        $('#nomeModal').text(nome);
        $('#modalExcluir').modal('show');
    }

    function confirmarExclusao() {
        var id = $('#idExcluir').val();
        $.ajax({
            url: '/Escolaridade/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id },
            success: function (result) {
                if (result.success) {
                    $('#modalExcluir').modal('hide');
                    $('#linha-' + id).fadeOut(500, function () { $(this).remove(); });
                } else {
                    alert("Erro ao excluir.");
                }
            }
        });
    }
</script>