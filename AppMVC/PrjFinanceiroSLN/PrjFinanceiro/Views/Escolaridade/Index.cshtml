@model IEnumerable<PrjFinanceiro.Models.Escolaridade>

<div class="container mt-5">
    <h2 class="mb-4">Tabela Escolaridade- @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Escolaridade/Criar" class="btn btn-success">Cadastrar Escolaridade</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descrição</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Escolaridade/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Escolaridade/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>