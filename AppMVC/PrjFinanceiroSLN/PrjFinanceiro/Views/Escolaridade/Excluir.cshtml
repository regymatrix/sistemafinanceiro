@model PrjFinanceiro.Models.Escolaridade

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Escolaridade</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger">Tem certeza que deseja remover esta escolaridade?</h4>
            <p class="text-muted">Aviso: Se houver funcionários vinculados a esta escolaridade, a exclusão poderá falhar no banco de dados.</p>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Código:</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Descrição:</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>
            </dl>

            <form action="/Escolaridade/ExcluirConfirmado" method="post">
                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <button type="submit" class="btn btn-danger">Sim, Excluir Definitivamente</button>
                <a href="/Escolaridade/Index" class="btn btn-secondary">Cancelar e Voltar</a>
            </form>
        </div>
    </div>
</div>