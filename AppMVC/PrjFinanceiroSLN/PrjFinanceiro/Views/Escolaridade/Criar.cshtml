@model PrjFinanceiro.Models.Escolaridade

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Nova Escolaridade</h2>
        </div>
        <div class="card-body">
            <form action="/Escolaridade/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="codigoescolaridade">Codigo Escolaridade:</label>
                    <input type="text" id="nome" name="codigoescolaridade" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="descricaoescolaridade">Descrição Escolaridade:</label>
                    <input type="text" id="descricaoescolaridade" name="descricaoescolaridade" class="form-control" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Escolaridade</button>
                    <a href="/Escolaridade/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>

            </form>
        </div>
    </div>
</div>