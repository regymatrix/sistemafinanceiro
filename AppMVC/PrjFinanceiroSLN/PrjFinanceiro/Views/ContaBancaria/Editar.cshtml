@model PrjFinanceiro.Models.ContaBancaria

<div class="container mt-5">
    <div class="card">

        <div class="card-header bg-primary text-white">
            <h2>Editar Conta Bancária</h2>
        </div>

        <div class="card-body">

            <form action="/ContaBancaria/Editar" method="post">

                <input type="hidden"
                       name="codigoCliente"
                       value="@Model.CodigoCliente" />

                <div class="form-group mb-3">
                    <label>Código Agência</label>

                    <input type="number"
                           name="codigoAgencia"
                           class="form-control"
                           value="@Model.CodigoAgencia" />
                </div>

                <div class="form-group mb-3">
                    <label>Número Conta</label>

                    <input type="number"
                           name="numeroConta"
                           class="form-control"
                           value="@Model.NumeroConta" />
                </div>

                <div class="form-group mb-3">
                    <label>Status Conta</label>

                    <select name="statusConta" class="form-control">

                        <option value="true"
                                selected="@(Model.StatusConta ? "selected" : null)">
                            Ativa
                        </option>

                        <option value="false"
                                selected="@(!Model.StatusConta ? "selected" : null)">
                            Inativa
                        </option>

                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>Tipo Conta</label>

                    <input type="text"
                           name="tipoConta"
                           class="form-control"
                           value="@Model.TipoConta" />
                </div>

                <div class="form-group mt-4">

                    <button type="submit" class="btn btn-primary">
                        Salvar Alterações
                    </button>

                    <a href="/ContaBancaria/Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>