@model PrjFinanceiro.Models.ContaBancaria

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h2 class="m-0">Excluir Conta Bancária</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger mb-4">Tem certeza que deseja remover esta conta permanentemente?</h4>

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Nome/Apelido:</dt>
                        <dd class="col-sm-8">@Model.Nome</dd>

                        <dt class="col-sm-4">Número:</dt>
                        <dd class="col-sm-8">@Model.NumeroConta</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Tipo:</dt>
                        <dd class="col-sm-8">@Model.TipoConta</dd>

                        <dt class="col-sm-4">Titular:</dt>
                        <dd class="col-sm-8">@(Model.ClienteRel?.Nome ?? "N/A")</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <form action="/ContaBancaria/ExcluirConfirmado" method="post">
                <input type="hidden" name="codigo" value="@Model.Codigo" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger px-4">Confirmar Exclusão</button>
                    <a href="/ContaBancaria/Index" class="btn btn-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>