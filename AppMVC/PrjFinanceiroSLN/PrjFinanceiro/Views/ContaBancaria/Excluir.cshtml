@model PrjFinanceiro.Models.ContaBancaria

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white"><h2>Encerrar/Excluir Conta Bancária</h2></div>
        <div class="card-body">
            <h4 class="text-danger mb-4">Tem certeza de que deseja remover esta conta permanentemente do sistema?</h4>
            <dl class="row">
                <dt class="col-sm-3">Número da Conta:</dt>
                <dd class="col-sm-9">@Model.NumeroConta</dd>
                <dt class="col-sm-3">Agência:</dt>
                <dd class="col-sm-9">@Model.CodigoAgencia</dd>
                <dt class="col-sm-3">Titular:</dt>
                <dd class="col-sm-9">@(Model.ClienteRel?.Nome ?? "N/A")</dd>
                <dt class="col-sm-3">Tipo de Conta:</dt>
                <dd class="col-sm-9">@Model.TipoConta</dd>
                <dt class="col-sm-3">Status Atual:</dt>
                <dd class="col-sm-9">@(Model.StatusConta ? "Ativa" : "Inativa")</dd>
            </dl>
            <form action="/ContaBancaria/ExcluirConfirmado" method="post">
                <input type="hidden" name="numeroConta" value="@Model.NumeroConta" />
                <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                <a href="/ContaBancaria/Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>