@model PrjFinanceiro.Models.ContaBancaria

<div class="container mt-5">
    <div class="card border-danger">

        <div class="card-header bg-danger text-white">
            <h2>Excluir Conta Bancária</h2>
        </div>

        <div class="card-body">

            <h4 class="text-danger">
                Tem certeza que deseja excluir esta conta?
            </h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">@Model.CodigoCliente</dd>

                <dt class="col-sm-3">Agência</dt>
                <dd class="col-sm-9">@Model.CodigoAgencia</dd>

                <dt class="col-sm-3">Conta</dt>
                <dd class="col-sm-9">@Model.NumeroConta</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Model.TipoConta</dd>

            </dl>

            <form action="/ContaBancaria/ExcluirConfirmado"
                  method="post">

                <input type="hidden"
                       name="codigoCliente"
                       value="@Model.CodigoCliente" />

                <button type="submit"
                        class="btn btn-danger">
                    Sim, Excluir
                </button>

                <a href="/ContaBancaria/Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>