@model IEnumerable<PrjFinanceiro.Models.ContaBancaria>

<div class="container mt-5">
    <h2>Lista de Contas</h2>
    <a href="/ContaBancaria/Criar" class="btn btn-success mb-3">Nova Conta</a>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Número</th>
                <th>Cliente</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.NumeroConta</td>
                    <td>@(item.ClienteRel?.Nome)</td>
                    <td>
                        <a href="/ContaBancaria/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button class="btn btn-sm btn-danger" onclick="abrirModalExcluir(@item.Codigo, '@item.Nome')">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/ContaBancaria/Excluir" method="post">
                <div class="modal-header bg-danger text-white"><h5>Excluir Conta</h5></div>
                <div class="modal-body">
                    <input type="hidden" name="codigo" id="codigoExcluir" />
                    <p>Deseja excluir a conta <strong id="nomeConta"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sair</button>
                    <button type="submit" class="btn btn-danger">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function abrirModalExcluir(id, nome) {
        document.getElementById('codigoExcluir').value = id;
        document.getElementById('nomeConta').innerText = nome;
        new bootstrap.Modal(document.getElementById('modalExcluir')).show();
    }
</script>