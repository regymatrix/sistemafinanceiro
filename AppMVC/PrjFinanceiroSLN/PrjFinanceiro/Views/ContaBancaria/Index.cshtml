@model IEnumerable<PrjFinanceiro.Models.ContaBancaria>

<div class="container mt-5">

    <h2 class="mb-4">
        Lista de Contas Bancárias
    </h2>

    <p>
        <a href="/ContaBancaria/Criar"
           class="btn btn-success">
            Cadastrar Nova Conta
        </a>
    </p>

    <table class="table table-bordered table-hover">

        <thead class="thead-dark">
            <tr>
                <th>Cliente</th>
                <th>Agência</th>
                <th>Número Conta</th>
                <th>Status</th>
                <th>Tipo Conta</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.CodigoCliente</td>
                    <td>@item.CodigoAgencia</td>
                    <td>@item.NumeroConta</td>

                    <td>
                        @(item.StatusConta ? "Ativa" : "Inativa")
                    </td>

                    <td>@item.TipoConta</td>

                    <td>

                        <a href="/ContaBancaria/Editar/@item.CodigoCliente"
                           class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <a href="/ContaBancaria/Excluir/@item.CodigoCliente"
                           class="btn btn-sm btn-danger">
                            Excluir
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
</div>