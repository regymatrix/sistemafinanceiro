@model IEnumerable<PrjFinanceiro.Models.ContaBancaria>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Contas Bancárias - @ViewBag.nomesenaii</h2>

    <p>
        <a href="/ContaBancaria/Criar" class="btn btn-success">Cadastrar Nova Conta Bancária</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Código Cliente</th>
                <th>Código Agência</th>
                <th>Número da Conta</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // MODIFICADO: O ID da linha agora é baseado no item.Codigo
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.CodigoCliente</td>
                    <td>@item.CodigoAgencia</td>
                    <td>@item.NumeroConta</td>
                    <td>@item.TipoConta</td>
                    <td>
                        <span class="badge @(item.StatusConta ? "bg-success" : "bg-danger")">
                            @(item.StatusConta ? "Ativa" : "Inativa")
                        </span>
                    </td>
                    <td>
                        <a href="/ContaBancaria/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>

                        <button type="button" class="btn btn-sm btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.NumeroConta')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir a conta número <strong id="numeroContaModal"></strong>?</p>
                <input type="hidden" id="idContaExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Função para preparar o modal com os dados da conta selecionada
    function abrirModalExcluir(id, numeroConta) {
        $('#idContaExcluir').val(id); // Recebe o novo 'Codigo'
        $('#numeroContaModal').text(numeroConta);
        $('#modalExcluir').modal('show');
    }

    // Função que envia a requisição para o C#
    function confirmarExclusao() {
        var id = $('#idContaExcluir').val();

        $.ajax({
            url: '/ContaBancaria/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id }, // Envia o 'Codigo' para o parâmetro do controller
            success: function (result) {
                if (result.success) {
                    // Fecha o modal
                    $('#modalExcluir').modal('hide');
                    // Remove a linha correta da tabela com um efeito suave baseado no novo ID
                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });
                } else {
                    alert(result.message);
                }
            },
            error: function () {
                alert("Erro técnico ao tentar excluir a conta bancária.");
            }
        });
    }
</script>