@model PrjFinanceiro.Models.Funcionario

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h2 class="m-0">Excluir Funcionário</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger mb-4">Tem certeza que deseja remover este funcionário permanentemente?</h4>

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Nome:</dt>
                        <dd class="col-sm-8">@Model.Nome</dd>

                        <dt class="col-sm-4">CPF:</dt>
                        <dd class="col-sm-8">@FormatarCPF(Model.CPF)</dd>

                        <dt class="col-sm-4">Data Nasc.:</dt>
                        <dd class="col-sm-8">@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Telefone:</dt>
                        <dd class="col-sm-8">@FormatarTelefone(Model.Telefone)</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Localização:</dt>
                        <dd class="col-sm-8">
                            @(Model.BairroRel?.NomeBairro), @(Model.CidadeRel?.NomeCidade) - @Model.EstadoUF
                        </dd>

                        <dt class="col-sm-4">Escolaridade:</dt>
                        <dd class="col-sm-8">@(Model.Escolaridade?.Descricao ?? "N/A")</dd>

                        <dt class="col-sm-4">Etnia:</dt>
                        <dd class="col-sm-8">@(Model.Etnia?.Descricao ?? "N/A")</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <form action="/Funcionario/ExcluirConfirmado" method="post">
                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="mt-3">
                    <button type="submit" class="btn btn-danger px-4">Confirmar Exclusão</button>
                    <a href="/Funcionario/Index" class="btn btn-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public string FormatarCPF(string cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return "";
        var d = System.Text.RegularExpressions.Regex.Replace(cpf, @"\D", "");
        return d.Length == 11 ? long.Parse(d).ToString(@"000\.000\.000\-00") : cpf;
    }

    public string FormatarTelefone(string tel)
    {
        if (string.IsNullOrWhiteSpace(tel)) return "";
        var d = System.Text.RegularExpressions.Regex.Replace(tel, @"\D", "");
        if (d.Length == 11) return long.Parse(d).ToString(@"(00) 00000-0000");
        if (d.Length == 10) return long.Parse(d).ToString(@"(00) 0000-0000");
        return tel;
    }
}