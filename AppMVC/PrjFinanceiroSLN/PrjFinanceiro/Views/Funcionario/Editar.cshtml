@model PrjFinanceiro.Models.Funcionario

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>Editar Funcionario</h2>
        </div>
        <div class="card-body">
            <form action="/Funcionario/Editar" method="post">
                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label>Nome</label>
                        <input type="text" name="nome" class="form-control" value="@Model.Nome" required />
                    </div>
                    <div class="col-md-4">
                        <label>Data Nasc.</label>
                        <input type="date" name="data" class="form-control" value="@Model.DataNascimento.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label>CPF</label>
                        <input type="text" name="cpf" class="form-control mask-cpf" value="@Model.CPF" required />
                    </div>

                    <div class="col-md-4">
                        <label>Telefone</label>
                        <input type="text" name="telefone" class="form-control mask-tel" value="@Model.Telefone" required />
                    </div>

                    <div class="col-md-4">
                        <label>UF</label>
                        <select name="estadoUF" class="form-select" required>
                            @foreach (var e in ViewBag.Estados)
                            {
                                <option value="@e.Sigla" selected="@(e.Sigla == Model.EstadoUF ? "selected" : null)">@e.Sigla</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Cidade</label>
                        <select name="codigoCidade" class="form-select" required>
                            @foreach (var c in ViewBag.Cidades)
                            {
                                <option value="@c.Codigo" selected="@(c.Codigo == Model.CodigoCidade ? "selected" : null)">@c.NomeCidade</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Bairro</label>
                        <select name="codigoBairro" class="form-select" required>
                            @foreach (var b in ViewBag.Bairros)
                            {
                                <option value="@b.Codigo" selected="@(b.Codigo == Model.CodigoBairro ? "selected" : null)">@b.NomeBairro</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Escolaridade</label>
                        <select name="codigoEscolaridade" class="form-select" required>
                            @foreach (var esc in ViewBag.Escolaridades)
                            {
                                <option value="@esc.Codigo" selected="@(esc.Codigo == Model.CodigoEscolaridade ? "selected" : null)">@esc.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Etnia</label>
                        <select name="codigoEtnia" class="form-select" required>
                            @foreach (var et in ViewBag.Etnias)
                            {
                                <option value="@et.Codigo" selected="@(et.Codigo == Model.CodigoEtnia ? "selected" : null)">@et.Descricao</option>
                            }
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                <a href="/Funcionario/Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        $(document).ready(function(){
            $('.mask-cpf').mask('000.000.000-00');
            $('.mask-tel').mask('(00) 00000-0000');
        });
    </script>
}