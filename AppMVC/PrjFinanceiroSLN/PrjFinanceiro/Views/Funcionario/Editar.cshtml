@model PrjFinanceiro.Models.Funcionario

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar Funcionario</h2>
        </div>
        <div class="card-body">
            <form action="/Funcionario/Editar" method="post">

                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label for="nome">Nome do Funcionario</label>
                    <input type="text" id="nome" name="nome" class="form-control" value="@Model.Nome" required />
                </div>

                <div class="form-group mb-3">
                    <label for="data">Data de Nascimento</label>
                    @* O formato yyyy-MM-dd é obrigatório para o input type="date" reconhecer o valor *@
                    <input type="date" id="data" name="data" class="form-control" value="@Model.DataNascimento.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="form-group mb-3">
                    <label for="cidade">Cidade</label>
                    <input type="text" id="cidade" name="cidade" class="form-control" value="@Model.Cidade" required />
                </div>

                <div class="form-group mb-3">
                    <label for="estadoUF">Estado (UF)</label>
                    <input type="text" id="estadoUF" name="estadoUF" class="form-control" maxlength="2" value="@Model.EstadoUF" required />
                </div>

                <div class="form-group mb-3">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" name="cpf" class="form-control" maxlength="20" value="@Model.CPF" required />
                </div>

                <div class="form-group mb-3">
                    <label for="telefone">Telefone</label>
                    <input type="text" id="telefone" name="telefone" class="form-control" maxlength="20" value="@Model.Telefone" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    <a href="/Funcionario/Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>