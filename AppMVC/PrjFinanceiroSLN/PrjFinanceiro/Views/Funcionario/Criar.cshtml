@model PrjFinanceiro.Models.Funcionario

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Novo Funcionario</h2>
        </div>
        <div class="card-body">
            <form action="/Funcionario/Criar" method="post">

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label for="nome">Nome Completo</label>
                        <input type="text" id="nome" name="nome" class="form-control" required />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label for="data">Data de Nascimento</label>
                        <input type="date" id="data" name="data" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" name="cpf" class="form-control mask-cpf" placeholder="000.000.000-00" required />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label for="telefone">Telefone</label>
                        <input type="text" id="telefone" name="telefone" class="form-control mask-tel" placeholder="(00) 00000-0000" required />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label for="estadoUF">UF</label>
                        <input type="text" id="estadoUF" name="estadoUF" class="form-control" maxlength="2" required />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="cidade">Cidade</label>
                    <input type="text" id="cidade" name="cidade" class="form-control" required />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label>Escolaridade</label>
                        <select name="codigoEscolaridade" class="form-control" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var esc in ViewBag.Escolaridades)
                            {
                                <option value="@esc.Codigo">@esc.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label>Etnia</label>
                        <select name="codigoEtnia" class="form-control" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var et in ViewBag.Etnias)
                            {
                                <option value="@et.Codigo">@et.Descricao</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Funcionário</button>
                    <a href="/Funcionario/Index" class="btn btn-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.mask-cpf').mask('000.000.000-00');
            var behavior = function (val) {
                return val.replace(/\D/g, '').length === 11 ? '(00) 00000-0000' : '(00) 0000-00009';
            },
            options = {
                onKeyPress: function (val, e, field, options) {
                    field.mask(behavior.apply({}, arguments), options);
                }
            };
            $('.mask-tel').mask(behavior, options);
        });
    </script>
}