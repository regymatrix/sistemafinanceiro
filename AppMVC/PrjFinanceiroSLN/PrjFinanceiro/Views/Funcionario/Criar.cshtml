@model PrjFinanceiro.Models.Funcionario

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h2 class="m-0">Cadastrar Novo Funcionario</h2>
        </div>
        <div class="card-body">
            <form action="/Funcionario/Criar" method="post">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label>Nome Completo</label>
                        <input type="text" name="nome" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label>Data de Nascimento</label>
                        <input type="date" name="data" class="form-control" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label>CPF</label>
                        <input type="text" name="cpf" class="form-control mask-cpf" placeholder="000.000.000-00" required />
                    </div>
                    <div class="col-md-4">
                        <label>Telefone</label>
                        <input type="text" name="telefone" class="form-control mask-tel" placeholder="(00) 00000-0000" required />
                    </div>
                    <div class="col-md-4">
                        <label>UF</label>
                        <select name="estadoUF" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var e in ViewBag.Estados)
                            {
                                <option value="@e.Sigla">@e.Sigla</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Cidade</label>
                        <select name="codigoCidade" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var c in ViewBag.Cidades)
                            {
                                <option value="@c.Codigo">@c.NomeCidade</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label>Bairro</label>
                        <select name="codigoBairro" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var b in ViewBag.Bairros)
                            {
                                <option value="@b.Codigo">@b.NomeBairro</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Escolaridade</label>
                        <select name="codigoEscolaridade" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var esc in ViewBag.Escolaridades)
                            {
                                <option value="@esc.Codigo">@esc.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label>Etnia</label>
                        <select name="codigoEtnia" class="form-select" required>
                            <option value="">-- Selecione --</option>
                            @foreach (var et in ViewBag.Etnias)
                            {
                                <option value="@et.Codigo">@et.Descricao</option>
                            }
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Salvar Funcionário</button>
                <a href="/Funcionario/Index" class="btn btn-secondary">Voltar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        $(document).ready(function(){
            $('.mask-cpf').mask('000.000.000-00');
            $('.mask-tel').mask('(00) 00000-0000');
        });
    </script>
}