@model IEnumerable<PrjFinanceiro.Models.Funcionario>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Funcionários</h2>
    <p><a href="/Funcionario/Criar" class="btn btn-success">Novo Funcionário</a></p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Data Nasc.</th>
                <th>CPF</th>
                <th>Telefone</th>
                <th>Escolaridade</th>
                <th>Etnia</th>
                <th style="width: 150px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@FormatarCPF(item.CPF)</td>
                    <td>@FormatarTelefone(item.Telefone)</td>
                    <td>@(item.Escolaridade != null ? item.Escolaridade.Descricao : "N/A")</td>
                    <td>@(item.Etnia != null ? item.Etnia.Descricao : "N/A")</td>
                    <td>
                        <a href="/Funcionario/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Funcionario/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    public string FormatarCPF(string cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return "";
        var d = System.Text.RegularExpressions.Regex.Replace(cpf, @"\D", "");
        return d.Length == 11 ? long.Parse(d).ToString(@"000\.000\.000\-00") : cpf;
    }

    public string FormatarTelefone(string tel)
    {
        if (string.IsNullOrWhiteSpace(tel)) return "";
        var d = System.Text.RegularExpressions.Regex.Replace(tel, @"\D", "");
        if (d.Length == 11) return long.Parse(d).ToString(@"(00) 00000-0000");
        if (d.Length == 10) return long.Parse(d).ToString(@"(00) 0000-0000");
        return tel;
    }
}