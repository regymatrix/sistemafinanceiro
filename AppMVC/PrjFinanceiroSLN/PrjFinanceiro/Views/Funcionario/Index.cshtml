@model IEnumerable<PrjFinanceiro.Models.Funcionario>

<div class="container mt-5">
    <h2>Lista de Funcionários</h2>
    <a href="/Funcionario/Criar" class="btn btn-success mb-3">Novo Funcionário</a>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>Cidade/Bairro</th>
                <th>Escolaridade</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@FormatarCPF(item.CPF)</td>
                    <td>@(item.CidadeRel?.NomeCidade) / @(item.BairroRel?.NomeBairro) (@item.EstadoUF)</td>
                    <td>@(item.Escolaridade?.Descricao)</td>
                    <td>
                        <a href="/Funcionario/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Funcionario/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    public string FormatarCPF(string cpf) => (cpf?.Length == 11) ? long.Parse(cpf).ToString(@"000\.000\.000\-00") : cpf;
}