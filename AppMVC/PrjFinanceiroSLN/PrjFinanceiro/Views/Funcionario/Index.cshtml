@model IEnumerable<PrjFinanceiro.Models.Funcionario>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Agências Bancárias -  @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Funcionario/Criar" class="btn btn-success">Cadastrar Novo Funcionário</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>DataNascimento</th>
                <th>Cidade</th>
                <th>Estado (UF)</th>
                <th>CPF</th>
                <th>Telefone</th>
                <th>Ações</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nome</td>
                    <td>@item.DataNascimento.ToString()</td>
                    <td>@item.Cidade</td>
                    <td>@item.EstadoUF</td>
                    <td>@item.CPF</td>
                    <td>@item.Telefone</td>
                    <td>
                        <a href="/Agencia/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Agencia/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>