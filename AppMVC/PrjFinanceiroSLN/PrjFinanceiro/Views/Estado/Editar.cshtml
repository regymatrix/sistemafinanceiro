@model PrjFinanceiro.Models.Estado

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar Estado</h2>
        </div>
        <div class="card-body">
            <form action="/Estado/Editar" method="post">

                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label for="NomeEstado">Nome do Estado</label>
                    <input type="text" id="NomeEstado" name="NomeEstado" class="form-control" value="@Model.NomeEstado" required />
                </div>

                <div class="form-group mb-3">
                    <label for="Sigla">Sigla</label>
                    <input type="text" id="Sigla" name="Sigla" class="form-control" value="@Model.Sigla" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    <a href="/Estado/Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>