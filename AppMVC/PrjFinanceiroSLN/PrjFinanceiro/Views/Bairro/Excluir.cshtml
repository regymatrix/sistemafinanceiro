@model PrjFinanceiro.Models.Bairro

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Bairro</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger">Tem certeza que deseja excluir este bairro?</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Código:</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Bairro:</dt>
                <dd class="col-sm-9">@Model.NomeBairro</dd>

                <dt class="col-sm-3">Cidade:</dt>
                <dd class="col-sm-9">@(Model.Cidade != null ? Model.Cidade.NomeCidade : "Não informada")</dd>
            </dl>

            <form action="/Bairro/ExcluirConfirmado" method="post">
                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                <a href="/Bairro/Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
