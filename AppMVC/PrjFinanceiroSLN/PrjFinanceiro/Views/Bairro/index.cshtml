@model IEnumerable<PrjFinanceiro.Models.Bairro>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Bairros</h2>
    <p><a href="/Bairro/Criar" class="btn btn-success">Cadastrar Novo Bairro</a></p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome do Bairro</th>
                <th>Cidade</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.NomeBairro</td>
                    <td>@(item.Cidade?.NomeCidade ?? "N/A")</td>
                    <td>
                        <a href="/Bairro/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-danger btn-sm" 
                                onclick="abrirModalExcluir(@item.Codigo, '@item.NomeBairro')">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5>Confirmar Exclusão</h5></div>
            <div class="modal-body">
                <p>Deseja excluir o bairro <strong id="nomeBairroModal"></strong>?</p>
                <input type="hidden" id="idBairroExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

<script>
    function abrirModalExcluir(id, nome) {
        $('#idBairroExcluir').val(id);
        $('#nomeBairroModal').text(nome);
        $('#modalExcluir').modal('show');
    }

    function confirmarExclusao() {
        var id = $('#idBairroExcluir').val();
        $.ajax({
            url: '/Bairro/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id },
            success: function (result) {
                if (result.success) {
                    $('#modalExcluir').modal('hide');
                    $('#linha-' + id).fadeOut(500, function () { $(this).remove(); });
                } else { alert(result.message); }
            }
        });
    }
</script>