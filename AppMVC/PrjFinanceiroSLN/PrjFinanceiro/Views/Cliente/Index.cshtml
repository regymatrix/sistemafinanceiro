@model IEnumerable<PrjFinanceiro.Models.Cliente>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Clientes -  @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Cliente/Criar" class="btn btn-success">Cadastrar Novo Cliente</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Data Nascimento</th>
                <th>Tipo Cliente</th>
                <th>CPF</th>
                <th>CNPJ</th>
                <th>Código Bairro </th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.Nome</td>
                    <td>@item.DataNascimento.ToShortDateString()</td>
                    <td>@item.TipoCliente</td>
                    <td>@item.CPF</td>
                    <td>@item.CNPJ</td>
                    <td>@item.CodigoBairro</td>

                    <td>
                        <a href="/Cliente/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>

                        <button type="button" class="btn btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.Nome')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>

            <div class="modal-body">
                <p>Tem certeza que deseja excluir o cliente <strong id="nomeClienteModal"></strong>?</p>

                <input type="hidden" id="idClienteExcluir" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">
                    Sim, Excluir
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Função para preparar o modal com os dados do cliente selecionado
    function abrirModalExcluir(id, nome) {
        $('#idClienteExcluir').val(id);
        $('#nomeClienteModal').text(nome);
        $('#modalExcluir').modal('show');
    }

    // Função que envia a requisição para o C#
    function confirmarExclusao() {
        var id = $('#idClienteExcluir').val();

        $.ajax({
            url: '/Cliente/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id },

            success: function (result) {
                if (result.success) {

                    // Fecha o modal
                    $('#modalExcluir').modal('hide');

                    // Remove a linha da tabela com um efeito suave
                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });

                } else {
                    alert(result.message);
                }
            },

            error: function () {
                alert("Erro técnico ao tentar excluir.");
            }
        });
    }
</script>
