@model IEnumerable<PrjFinanceiro.Models.Cliente>

<div class="container mt-5">

    <h2 class="mb-4">Lista de Clientes</h2>

    <p>
        <a href="/Cliente/Criar" class="btn btn-success">
            Cadastrar Novo Cliente
        </a>
    </p>

    <table class="table table-bordered table-hover">

        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Tipo</th>
                <th>CPF</th>
                <th>CNPJ</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">

                    <td>@item.Codigo</td>
                    <td>@item.Nome</td>
                    <td>@item.TipoCliente</td>
                    <td>@item.CPF</td>
                    <td>@item.CNPJ</td>

                    <td>

                        <a href="/Cliente/Editar/@item.Codigo"
                           class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.Nome')">

                            Excluir

                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>
</div>