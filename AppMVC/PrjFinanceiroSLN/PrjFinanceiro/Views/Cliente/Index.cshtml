@model IEnumerable<PrjFinanceiro.Models.Cliente>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Clientes - @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Cliente/Criar" class="btn btn-success">Cadastrar Novo Cliente</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Data de Nascimento</th>
                <th>Tipo de Cliente</th>
                <th>CPF</th>
                <th>CNPJ</th>
                <th>Código do Bairro</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nome</td>
                    <td>@item.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@(item.TipoCliente == "Fisica" ? "Pessoa Física" : "Pessoa Jurídica")</td>
                    <td>@(string.IsNullOrEmpty(item.CPF) ? "-" : item.CPF)</td>
                    <td>@(string.IsNullOrEmpty(item.CNPJ) ? "-" : item.CNPJ)</td>
                    <td>@item.CodigoBairro</td>
                    <td>
                        <a href="/Cliente/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Cliente/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>