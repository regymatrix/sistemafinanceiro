@model IEnumerable<PrjFinanceiro.Models.Cliente>

<div class="container mt-5">
    <h2>Lista de Clientes</h2>
    <a href="/Cliente/Criar" class="btn btn-success mb-3">Novo Cliente</a>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Documento</th>
                <th>Bairro</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.TipoCliente</td>
                    <td>@(item.TipoCliente == "Física" ? item.CPF : item.CNPJ)</td>
                    <td>@(item.BairroRel?.NomeBairro ?? "N/A")</td>
                    <td>
                        <a href="/Cliente/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Cliente/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>