@model PrjFinanceiro.Models.Cliente

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar Cliente</h2>
        </div>

        <div class="card-body">
            <form action="/Cliente/Editar" method="post">

                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label>Nome</label>
                    <input type="text"
                           name="nome"
                           class="form-control"
                           value="@Model.Nome"
                           required />
                </div>

                <div class="form-group mb-3">
                    <label>Data de Nascimento</label>
                    <input type="date"
                           name="dataNascimento"
                           class="form-control"
                           value="@Model.DataNascimento" />
                </div>

                <div class="form-group mb-3">
                    <label>Tipo Cliente</label>
                    <select name="tipoCliente" class="form-control">

                        <option value="PF"
                                selected="@(Model.TipoCliente == "PF" ? "selected" : null)">
                            Pessoa Física
                        </option>

                        <option value="PJ"
                                selected="@(Model.TipoCliente == "PJ" ? "selected" : null)">
                            Pessoa Jurídica
                        </option>

                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>CPF</label>
                    <input type="text"
                           name="cpf"
                           class="form-control"
                           value="@Model.CPF" />
                </div>

                <div class="form-group mb-3">
                    <label>CNPJ</label>
                    <input type="text"
                           name="cnpj"
                           class="form-control"
                           value="@Model.CNPJ" />
                </div>

                <div class="form-group mb-3">
                    <label>Código Bairro</label>
                    <input type="text"
                           name="codigoBairro"
                           class="form-control"
                           value="@Model.CodigoBairro" />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        Salvar Alterações
                    </button>

                    <a href="/Cliente/Index" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>