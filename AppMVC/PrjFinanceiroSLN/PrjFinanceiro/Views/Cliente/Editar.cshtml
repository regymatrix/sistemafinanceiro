```cshtml
@model PrjFinanceiro.Models.Cliente

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar Cliente</h2>
        </div>

        <div class="card-body">
            <form action="/Cliente/Editar" method="post">

                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label for="nome">Nome do Cliente</label>
                    <input type="text" id="nome" name="nome" class="form-control" value="@Model.Nome" required />
                </div>

                <div class="form-group mb-3">
                    <label for="dataNascimento">Data de Nascimento</label>
                    <input type="date" id="dataNascimento" name="dataNascimento"
                           value="@Model.DataNascimento.ToString("yyyy-MM-dd")"
                           class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="tipoCliente">Tipo do Cliente</label>
                    <input type="text" id="tipoCliente" name="tipoCliente" class="form-control" value="@Model.TipoCliente" required />
                </div>

                <div class="form-group mb-3">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" name="cpf" class="form-control" value="@Model.CPF" />
                </div>

                <div class="form-group mb-3">
                    <label for="cnpj">CNPJ</label>
                    <input type="text" id="cnpj" name="cnpj" class="form-control" value="@Model.CNPJ" />
                </div>

                <div class="form-group mb-3">
                    <label for="codigoBairro">Código do Bairro</label>
                    <input type="number" id="codigoBairro" name="codigoBairro" class="form-control" value="@Model.CodigoBairro" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    <a href="/Cliente/Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>
