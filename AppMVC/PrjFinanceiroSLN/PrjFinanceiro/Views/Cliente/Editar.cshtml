@model PrjFinanceiro.Models.Cliente

<div class="container mt-5">
    <h2>Editar Cliente</h2>
    <hr />
    <form action="/Cliente/Editar" method="post">
        <input type="hidden" name="codigo" value="@Model.Codigo" />

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Nome Completo</label>
                <input type="text" name="nome" class="form-control" value="@Model.Nome" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Data de Nascimento</label>
                <input type="date" name="data" class="form-control" value="@Model.DataNascimento.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value="Fisica" selected="@(Model.Tipo == "Fisica")">Pessoa Física</option>
                    <option value="Juridica" selected="@(Model.Tipo == "Juridica")">Pessoa Jurídica</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">CPF (se houver)</label>
                <input type="text" name="cpf" class="form-control" value="@Model.CPF" />
            </div>
            <div class="col-md-4">
                <label class="form-label">CNPJ (se houver)</label>
                <input type="text" name="cnpj" class="form-control" value="@Model.CNPJ" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Bairro</label>
                <select name="codigoBairro" class="form-select">
                    <option value="">-- Selecione --</option>
                    @foreach (var b in ViewBag.Bairros)
                    {
                        <option value="@b.Codigo" selected="@(b.Codigo == Model.CodigoBairro)">@b.NomeBairro</option>
                    }
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <a href="/Cliente/Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>