@model IEnumerable<PrjFinanceiro.Models.Cidade>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Cidades -  @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Cidade/Criar" class="btn btn-success">Cadastrar Nova Cidade</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Nome da Cidade</th>
                <th>Código IBGE</th>
                <th>Código do Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.NomeCidade</td>
                    <td>@item.CodigoIBGE</td>
                    <td>@item.CodigoEstado</td>
                    <td>
                        <a href="/Cidade/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.NomeCidade')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir a cidade <strong id="nomeCidadeModal"></strong>?</p>
                <input type="hidden" id="idCidadeExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>


<script>
    // Função para preparar o modal com os dados da agência selecionada
    function abrirModalExcluir(id, nome) {
        $('#idCidadeExcluir').val(id);
        $('#nomeCidadeModal').text(nome);
        $('#modalExcluir').modal('show');
    }

    // Função que envia a requisição para o C#
    function confirmarExclusao() {
        var id = $('#idCidadeExcluir').val();

        $.ajax({
            url: '/Cidade/ExcluirConfirmadoModal',
            type: 'POST',
            data: { codigo: id },
            success: function (result) {
                if (result.success) {
                    // Fecha o modal
                    $('#modalExcluir').modal('hide');
                    // Remove a linha da tabela com um efeito suave
                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });
                } else {
                    alert(result.message);
                }
            },
            error: function () {
                alert("Erro técnico ao tentar excluir.");
            }
        });
    }
</script>