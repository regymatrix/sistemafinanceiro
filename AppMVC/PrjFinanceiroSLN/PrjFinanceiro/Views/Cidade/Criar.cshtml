@model PrjFinanceiro.Models.Cidade

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Nova Cidade</h2>
        </div>
        <div class="card-body">
            <form action="/Cidade/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="nomecidade">Nome da Cidede</label>
                    <input type="text" id="nome" name="nome" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="codigoibge">Código IBGE</label>
                    <input type="text" id="codigoibge" name="codigoibge" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="codigoestado">Código do Estado</label>
                    <input type="text" id="codigoestado" name="codigoestado" class="form-control" maxlength="2" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Cidade</button>
                    <a href="/Cidade/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>

            </form>
        </div>
    </div>
</div>