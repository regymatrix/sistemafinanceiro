@model PrjFinanceiro.Models.Cidade

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Nova Cidade</h2>
        </div>
        <div class="card-body">
            <form action="/Cidade/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="nomecidade">Nome da Cidade</label>
                    <input type="text" id="nomecidade" name="nomecidade" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="codigoibge">Código IBGE</label>
                    <input type="text" id="codigoibge" name="codigoibge" class="form-control" maxlength="7" required />
                </div>

                <div class="form-group mb-3">
                    <label for="codigoestado">Estado (UF)</label>
                    <select id="codigoestado" name="codigoestado" class="form-control" required>
                        <option value="">-- Selecione o Estado --</option>
                        @foreach (var estado in ViewBag.Estados)
                        {
                            <option value="@estado.Codigo">@estado.Sigla - @estado.NomeEstado</option>
                        }
                    </select>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Cidade</button>
                    <a href="/Cidade/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>

            </form>
        </div>
    </div>
</div>