@model PrjFinanceiro.Models.Etnia

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Nova Etnia</h2>
        </div>
        <div class="card-body">
            <form action="/Etnia/Criar" method="post">
                <div class="form-group mb-3">
                    <label for="descricao">Descricao</label>
                    <input type="text" id="descricao" name="descricao" class="form-control" required />
                </div>
  
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Etnia</button>
                    <a href="/Etnia/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>
            </form>
        </div>
    </div>
</div>