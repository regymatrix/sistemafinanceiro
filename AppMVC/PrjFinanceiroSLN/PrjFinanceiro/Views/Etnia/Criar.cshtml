<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white"><h2>Nova Etnia</h2></div>
        <div class="card-body">
            <form action="/Etnia/Criar" method="post">
                <div class="mb-3">
                    <label>Descrição da Etnia</label>
                    <input type="text" name="Descricao" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/Etnia/Index" class="btn btn-secondary">Voltar</a>
            </form>
        </div>
    </div>
</div>