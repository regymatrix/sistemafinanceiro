@model IEnumerable<PrjFinanceiro.Models.Etnia>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Etnia - @ViewBag.nomesenaii</h2>

    <p>
        <a href="/Etnia/Criar" class="btn btn-success">Cadastrar Nova Etnia</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descricao</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Etnia/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/Etnia/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>