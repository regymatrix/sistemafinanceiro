@model IEnumerable<PrjFinanceiro.Models.Etnia>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Etnias</h2>
    <p><a href="/Etnia/Criar" class="btn btn-success">Cadastrar Nova Etnia</a></p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Etnia/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <button type="button" class="btn btn-sm btn-danger" 
                                onclick="exibirModalEtnia(@item.Codigo, '@item.Descricao')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalEtnia" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>
            <div class="modal-body">
                <p>Deseja realmente excluir a etnia <strong id="nomeEtnia"></strong>?</p>
                <input type="hidden" id="idEtniaExcluir" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="executarExclusaoEtnia()">Sim, Excluir</button>
            </div>
        </div>
    </div>
</div>

<script>
    function exibirModalEtnia(id, nome) {
        document.getElementById('idEtniaExcluir').value = id;
        document.getElementById('nomeEtnia').innerText = nome;
        var myModal = new bootstrap.Modal(document.getElementById('modalEtnia'));
        myModal.show();
    }

    function executarExclusaoEtnia() {
        var id = document.getElementById('idEtniaExcluir').value;

        fetch('/Etnia/ExcluirConfirmadoModal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'codigo=' + id
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert("Erro ao excluir.");
            }
        });
    }
</script>